  m_Script: {fileID: 11500000, guid: 0ae80392af3112d408e21a2f8f4afe41, type: 3}
  m_Name: IntroStory
  m_EditorClassIdentifier: StringAsASword.Runtime::StringAsASword.Core.StoryDefinition
  cards:
  - text: "\uD751\uACFC \uBC31\uC73C\uB85C \uB098\uB25C \uD310 \uC704\uC5D0\uC11C,\n\uBAA8\uB4E0
      \uB9D0\uC740 \uC815\uD574\uC9C4 \uCE78\uB9CC\uC744 \uBC1F\uB294\uB2E4."
    image: {fileID: 0}
  - text: "\uD310\uC744 \uB2E4\uC2A4\uB9AC\uB294 \uAC83\uC740 \uC655\uC758 \uC8FC\uC120\uC728.\n\uADF8
      \uBC15\uC790\uB97C \uBC97\uC5B4\uB09C \uC18C\uB9AC\uB294 \uC7A1\uC74C\uC774\uB77C
      \uBD88\uB838\uB2E4."
    image: {fileID: 0}
  - text: "\uD55C \uB9C8\uB9AC\uC758 \uB098\uC774\uD2B8\uAC00\n\uADF8 \uC7A1\uC74C\uC744
      \uB4E4\uC5C8\uB2E4."
    image: {fileID: 0}
  - text: "\uD769\uC5B4\uC9C4 \uC7A1\uC74C\uC744 \uBAA8\uC73C\uBA74\n\uBE7C\uC557\uAE34
      \uC120\uC728\uC744 \uB418\uCC3E\uC744 \uC218 \uC788\uB2E4."
    image: {fileID: 0}
  - text: "\uAC80\uC744 \uB4E4\uC5B4\uB77C.\n\uBC15\uC790\uC5D0 \uB9DE\uCDB0, \uD310\uC744
      \uBC97\uC5B4\uB098\uAE30 \uC704\uD574."
    image: {fileID: 0}
